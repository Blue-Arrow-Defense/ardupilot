   <iyy unit="KG*M2">  35.70    </iyy>
   <izz unit="KG*M2">  35.70    </izz>
   <emptywt unit="KG" >  90.00    </emptywt>
   <location name="CG" unit="M">
     <x> 1.61     </x>
     <y> 0.00     </y>
     <z> -0.09    </z>
   </location>
   <pointmass name="Payload">
    <description> 80.40 kg should bring model up to entered max weight </description>
    <weight unit="KG"> 40.20 </weight>
    <location name="POINTMASS" unit="M">
     <x> 1.61     </x>
     <y> 0.00     </y>
     <z> -0.09    </z>
   </location>
  </pointmass>
 </mass_balance>

 <propulsion>

   <engine file="MD550">
    <feed> 0 </feed>

    <thruster file="my_propeller">
     <sense> 1 </sense>
     <location unit="M">
       <x>     1.98 </x>
       <y>     0.00 </y>
       <z>     0.00 </z>
     </location>
     <orient unit="DEG">
       <pitch>     0.00 </pitch>
        <roll>     0.00 </roll>
         <yaw>     0.00 </yaw>
