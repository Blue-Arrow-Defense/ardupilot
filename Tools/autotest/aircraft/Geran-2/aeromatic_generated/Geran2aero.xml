       <x>     1.61 </x>
       <y>     0.00 </y>
       <z>    -0.09 </z>
     </location>
     <capacity unit="KG"> 14.80 </capacity>
     <contents unit="KG"> 7.40 </contents>
  </tank>
  <tank type="FUEL" number="1">
     <location unit="M">
       <x>     1.61 </x>
