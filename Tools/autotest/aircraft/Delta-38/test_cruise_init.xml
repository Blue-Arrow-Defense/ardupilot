<?xml version="1.0"?>
<!-- Standalone-JSBSim test IC: trimmed cruise at 300 m, 34 m/s.
     Used by scripts/d38_cruise.xml to validate the engine/propeller/drag
     balance without ArduPilot in the loop. Not used by SITL. -->
<initialize name="cruise">
  <latitude unit="DEG" type="geodetic"> 50.394647 </latitude>
  <longitude unit="DEG"> 30.057683 </longitude>
  <altitude unit="M"> 300.0 </altitude>
  <ubody unit="M/SEC"> 34.0 </ubody>
  <vbody unit="M/SEC"> 0.0 </vbody>
  <wbody unit="M/SEC"> 0.0 </wbody>
  <phi unit="DEG"> 0.0 </phi>
  <theta unit="DEG"> 6.0 </theta>
  <psi unit="DEG"> 0.0 </psi>
  <running> -1 </running>
</initialize>
